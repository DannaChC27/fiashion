# Copia este archivo como .env y pon tus datos reales. NUNCA subas .env a GitHub.

# --- IA: clave gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=pon_tu_clave_aqui
# Modelo con plan gratis, por ejemplo gemini-2.5-flash (usa el que aparece en AI Studio)
GEMINI_MODEL=gemini-2.5-flash

# --- Base de datos
# MySQL (MySQL Workbench / MySQL 8). Cambia "tu_clave" por la clave de root.
# La base "fiashion" se crea sola la primera vez.
DATABASE_URL=mysql+pymysql://root:tu_clave@localhost:3306/fiashion
# Si no tienes MySQL, borra la linea de arriba y se usa SQLite (archivo fiashion.db):
# DATABASE_URL=sqlite:///./fiashion.db
